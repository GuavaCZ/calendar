includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    ignoreErrors:
        # The widget's view lives under the 'guava-calendar' namespace, which is only registered at
        # runtime by CalendarServiceProvider, so larastan cannot resolve it to a view-string here.
        -
            identifier: property.defaultValue
            path: src/Filament/CalendarWidget.php
        # Both traits are part of the public Concerns namespace for users to opt into; nothing in
        # the package itself uses them, so PHPStan sees them as unused.
        -
            identifier: trait.unused
            paths:
                - src/Concerns/HasAuthorization.php
                - src/Concerns/HasNotifications.php
